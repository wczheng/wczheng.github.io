@article{sun2026fluidtest,
  display_order = {2},
  title = {Is Your Trajectory Displacement Safe in Long-tail?},
  author = {Qiao Sun and Weicheng Zheng and Yixin Huang and Hang Zhao*},
  year = {2026},
  month = jun,
  journal = {arXiv preprint arXiv:2606.16313},
  doi = {10.48550/arXiv.2606.16313},
  url = {https://fluidtest.web.app/},
  code = {https://github.com/Tsinghua-MARS-Lab/FluidTest},
  abstract = {FluidTest evaluates whether a planned trajectory introduces new safety threats relative to an expert reference. It combines structured human comparison, a semantic threat taxonomy, and an auditable multi-agent verification process for long-tail driving scenarios.},
  description = {A human-aligned and safety-aware evaluation framework for identifying additional threats in long-tail autonomous-driving scenarios.},
  keywords = {Autonomous Driving, Safety Evaluation, Long-tail Scenarios, Human Alignment},
  preview = {FluidTest.png}
}

